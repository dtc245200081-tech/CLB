# ============================================================
# CẤU HÌNH HỆ THỐNG QUẢN LÝ CÂU LẠC BỘ SINH VIÊN (GIAI ĐOẠN 1)
# ============================================================

# --- Ứng dụng & Môi trường ---
PROJECT_NAME="Hệ Thống Quản Lý Câu Lạc Bộ Sinh Viên"
ENV_MODE=development
DEBUG=True
API_V1_STR=/api

# --- Bảo mật & JWT ---
# CẢNH BÁO: Hãy đổi SECRET_KEY thành chuỗi ngẫu nhiên mạnh (tối thiểu 32 ký tự) khi chạy production!
SECRET_KEY=change-this-to-a-super-secret-key-at-least-32-chars-long-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Cơ sở dữ liệu (PostgreSQL 16 với pgvector) ---
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_123
POSTGRES_DB=clb_system_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres_password_123@db:5432/clb_system_db
DATABASE_URL_SYNC=postgresql://postgres:postgres_password_123@db:5432/clb_system_db

# --- CORS (Các domain frontend được phép gọi API) ---
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# --- Khởi tạo tài khoản Quản Trị Viên (Admin) đầu tiên ---
# Hệ thống chỉ tự động tạo nếu bảng users đang hoàn toàn trống
FIRST_ADMIN_EMAIL=admin@clb.edu.vn
FIRST_ADMIN_PASSWORD=Admin@123456
FIRST_ADMIN_STUDENT_ID=ADMIN001
FIRST_ADMIN_FULL_NAME=Quản Trị Viên Hệ Thống
FIRST_ADMIN_PHONE=0901234567
FIRST_ADMIN_FACULTY=Đoàn Thanh Niên - Hội Sinh Viên
FIRST_ADMIN_CLASS_NAME=BCH-CLB
FIRST_ADMIN_TITLE=Chủ nhiệm CLB

# --- Cổng ánh xạ ra máy chủ Host ---
HOST_PORT_HTTP=80
HOST_PORT_BACKEND=8000
HOST_PORT_FRONTEND=3000
HOST_PORT_DB=5432

# ============================================================
# GIAI ĐOẠN 5: CẤU HÌNH CHATBOT AI (GEMINI API & KHO TRI THỨC RAG)
# ============================================================
# Khóa API Gemini chính thức (lấy từ https://aistudio.google.com/app/apikey)
# Lưu ý: Tuyệt đối không commit khóa thật lên Git hoặc đưa xuống frontend
GEMINI_API_KEY=your_gemini_api_key_here

# Tên mô hình trò chuyện (dòng nhanh/nhỏ cho hỏi đáp, khuyến nghị: gemini-2.5-flash hoặc gemini-2.0-flash)
GEMINI_CHAT_MODEL=gemini-2.5-flash

# Tên mô hình vector embedding chính thức hiện hành từ ai.google.dev (gemini-embedding-001)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# Giới hạn số câu hỏi mỗi người dùng / mỗi IP mỗi ngày
CHAT_MAX_QUESTIONS_PER_USER_PER_DAY=50
CHAT_MAX_QUESTIONS_PER_IP_PER_DAY=20
CHAT_MAX_SYSTEM_QUESTIONS_PER_DAY=1000

# Tham số RAG Semantic Search
CHAT_RETRIEVAL_TOP_K=4
CHAT_RETRIEVAL_MIN_SCORE=0.65

# Số lượt hội thoại gần nhất đưa vào ngữ cảnh (cắt bớt để tối ưu độ trễ và chi phí token)
CHAT_HISTORY_TURNS=5

# Ngân sách suy nghĩ (0 để tắt / giảm độ trễ tối đa cho câu hỏi trực tiếp)
CHAT_THINKING_BUDGET=0
